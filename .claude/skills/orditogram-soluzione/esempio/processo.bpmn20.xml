<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_contributiEventi" targetNamespace="http://orditogram.it/processi">
  <message id="rinunciaAssociazione" name="rinunciaAssociazione" />
  <process id="contributiEventi" name="Contributi per eventi culturali" isExecutable="true" activiti:candidateStarterGroups="cultura">
    <documentation>Domanda di contributo di un'associazione dell'albo comunale per un evento culturale: protocollo, istruttoria entro 60 giorni con integrazioni e parere del dirigente sopra i 5.000 euro, comunicazione dell'esito e liquidazione.</documentation>
    <startEvent id="inizio" name="Domanda ricevuta" activiti:formKey="ce-domanda" />
    <serviceTask id="protocolla" name="Protocolla la domanda" implementation="apiConnector">
      <extensionElements>
        <activiti:field name="metodo" stringValue="POST" />
        <activiti:field name="url" stringValue="http://localhost:8080/api/demo/protocollo" />
        <activiti:field name="credenziale" stringValue="protocollo-demo" />
        <activiti:field name="corpo" stringValue="{&#10;  &quot;oggetto&quot;: &quot;Domanda di contributo: ${titoloEvento}&quot;,&#10;  &quot;mittente&quot;: &quot;${associazione_titolo}&quot;,&#10;  &quot;verso&quot;: &quot;entrata&quot;&#10;}" />
        <activiti:field name="risposta" stringValue="numeroProtocollo = numero&#10;dataProtocollo = data" />
        <activiti:field name="timeout" stringValue="20" />
        <activiti:field name="inErrore" stringValue="Segui la strada di errore" />
      </extensionElements>
    </serviceTask>
    <boundaryEvent id="erroreProtocollo" name="Protocollo non disponibile" attachedToRef="protocolla">
      <errorEventDefinition />
    </boundaryEvent>
    <userTask id="protocolloManuale" name="Protocolla a mano" activiti:candidateGroups="cultura" activiti:formKey="ce-protocollo" />
    <serviceTask id="conferma" name="Conferma ricezione all'associazione" implementation="emailConnector">
      <extensionElements>
        <activiti:field name="destinatari" stringValue="campo:pec" />
        <activiti:field name="oggetto" stringValue="Domanda di contributo per &quot;${titoloEvento}&quot;: protocollo ${numeroProtocollo}" />
        <activiti:field name="testo" stringValue="Gentile associazione,&#10;&#10;la domanda di contributo per l'evento &quot;${titoloEvento}&quot; è stata registrata con il protocollo n. ${numeroProtocollo} del ${dataProtocollo}.&#10;&#10;L'istruttoria si conclude entro 60 giorni (regolamento comunale, art. 8).&#10;&#10;Ufficio Cultura del Comune di Valfiorita" />
        <activiti:field name="allegati" stringValue="Nessuno" />
      </extensionElements>
    </serviceTask>
    <subProcess id="istruttoria" name="Istruttoria (60 giorni)">
      <startEvent id="iInizio" />
      <userTask id="verifica" name="Verifica la domanda" activiti:candidateGroups="cultura" activiti:formKey="ce-verifica" />
      <boundaryEvent id="sollecitoVerifica" name="Sollecito ogni 10 giorni" attachedToRef="verifica" cancelActivity="false">
        <timerEventDefinition>
          <timeCycle>R2/P10D</timeCycle>
        </timerEventDefinition>
      </boundaryEvent>
      <serviceTask id="notificaSollecito" name="Sollecita l'istruttore" implementation="notificaConnector">
        <extensionElements>
          <activiti:field name="destinatario" stringValue="gruppo:cultura" />
          <activiti:field name="titolo" stringValue="Da verificare: contributo per ${titoloEvento}" />
          <activiti:field name="messaggio" stringValue="La domanda di ${associazione_titolo} (protocollo ${numeroProtocollo}) aspetta la verifica. L'istruttoria si chiude entro 60 giorni dal protocollo." />
        </extensionElements>
      </serviceTask>
      <endEvent id="iFineSollecito" name="Sollecito inviato" />
      <exclusiveGateway id="esitoVerificaGw" name="Esito della verifica?" default="iAmmissibile" />
      <endEvent id="iFineIntegrazione" name="Servono integrazioni" />
      <endEvent id="iFineNonAmmissibile" name="Non ammissibile" />
      <exclusiveGateway id="sogliaGw" name="Più di 5.000 euro?" default="iSottoSoglia" />
      <userTask id="parere" name="Dai il parere sul contributo" activiti:candidateGroups="dirigenti" activiti:formKey="ce-parere" />
      <userTask id="decisione" name="Decidi il contributo" activiti:candidateGroups="cultura" activiti:formKey="ce-decisione" />
      <endEvent id="iFineDecisione" name="Decisione presa" />
      <sequenceFlow id="i1" sourceRef="iInizio" targetRef="verifica" />
      <sequenceFlow id="i2" sourceRef="verifica" targetRef="esitoVerificaGw" />
      <sequenceFlow id="i3" sourceRef="sollecitoVerifica" targetRef="notificaSollecito" />
      <sequenceFlow id="i4" sourceRef="notificaSollecito" targetRef="iFineSollecito" />
      <sequenceFlow id="iIntegrazione" name="Serve integrazione" sourceRef="esitoVerificaGw" targetRef="iFineIntegrazione">
        <conditionExpression xsi:type="tFormalExpression">${esitoVerifica == 'Serve integrazione'}</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="iNonAmmissibile" name="Non ammissibile" sourceRef="esitoVerificaGw" targetRef="iFineNonAmmissibile">
        <conditionExpression xsi:type="tFormalExpression">${esitoVerifica == 'Non ammissibile'}</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="iAmmissibile" name="Ammissibile" sourceRef="esitoVerificaGw" targetRef="sogliaGw" />
      <sequenceFlow id="iSopraSoglia" name="Sì" sourceRef="sogliaGw" targetRef="parere">
        <conditionExpression xsi:type="tFormalExpression">${importoRichiesto &gt; 5000.0}</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="iSottoSoglia" name="No" sourceRef="sogliaGw" targetRef="decisione" />
      <sequenceFlow id="i5" sourceRef="parere" targetRef="decisione" />
      <sequenceFlow id="i7" sourceRef="decisione" targetRef="iFineDecisione" />
    </subProcess>
    <boundaryEvent id="termine60" name="Termine di 60 giorni" attachedToRef="istruttoria">
      <timerEventDefinition activiti:businessCalendarName="proroga">
        <timeDuration>P60D</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <boundaryEvent id="rinuncia" name="Rinuncia dell'associazione" attachedToRef="istruttoria">
      <messageEventDefinition messageRef="rinunciaAssociazione" />
    </boundaryEvent>
    <endEvent id="fineRinuncia" name="Archiviata per rinuncia" />
    <serviceTask id="avvisoTermine" name="Avvisa i dirigenti del termine scaduto" implementation="notificaConnector">
      <extensionElements>
        <activiti:field name="destinatario" stringValue="gruppo:dirigenti" />
        <activiti:field name="titolo" stringValue="Termine scaduto: contributo per ${titoloEvento}" />
        <activiti:field name="messaggio" stringValue="Sono passati 60 giorni senza decisione sulla domanda di ${associazione_titolo} (protocollo ${numeroProtocollo}). La pratica è chiusa: la domanda va decisa fuori dal sistema." />
      </extensionElements>
    </serviceTask>
    <endEvent id="fineTermine" name="Termine decorso" />
    <exclusiveGateway id="dopoIstruttoria" name="Com'è finita l'istruttoria?" default="fDecisa" />
    <subProcess id="integrazioni" name="Richiesta di integrazioni">
      <startEvent id="rInizio" />
      <serviceTask id="emailIntegrazioni" name="Chiedi le integrazioni" implementation="emailConnector">
        <extensionElements>
          <activiti:field name="destinatari" stringValue="campo:pec" />
          <activiti:field name="oggetto" stringValue="Domanda di contributo ${numeroProtocollo}: servono integrazioni" />
          <activiti:field name="testo" stringValue="Gentile associazione,&#10;&#10;per completare l'istruttoria della domanda per l'evento &quot;${titoloEvento}&quot; ci servono:&#10;${noteVerifica}&#10;&#10;Le chiediamo di inviarle via PEC entro 15 giorni: senza risposta la domanda sarà archiviata.&#10;&#10;Ufficio Cultura del Comune di Valfiorita" />
          <activiti:field name="allegati" stringValue="Nessuno" />
        </extensionElements>
      </serviceTask>
      <userTask id="registraIntegrazioni" name="Registra le integrazioni" activiti:candidateGroups="cultura" activiti:formKey="ce-integrazioni" />
      <endEvent id="rFine" name="Integrazioni registrate" />
      <sequenceFlow id="r1" sourceRef="rInizio" targetRef="emailIntegrazioni" />
      <sequenceFlow id="r2" sourceRef="emailIntegrazioni" targetRef="registraIntegrazioni" />
      <sequenceFlow id="r3" sourceRef="registraIntegrazioni" targetRef="rFine" />
    </subProcess>
    <boundaryEvent id="nessunaIntegrazione" name="Nessuna risposta in 15 giorni" attachedToRef="integrazioni">
      <timerEventDefinition activiti:businessCalendarName="proroga">
        <timeDuration>P15D</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <endEvent id="fineArchiviata" name="Archiviata per mancate integrazioni" />
    <serviceTask id="emailNonAmmissibile" name="Comunica la non ammissibilità" implementation="emailConnector">
      <extensionElements>
        <activiti:field name="destinatari" stringValue="campo:pec" />
        <activiti:field name="oggetto" stringValue="Domanda di contributo ${numeroProtocollo}: non ammissibile" />
        <activiti:field name="testo" stringValue="Gentile associazione,&#10;&#10;la domanda di contributo per l'evento &quot;${titoloEvento}&quot; non è ammissibile per questo motivo:&#10;${noteVerifica}&#10;&#10;Contro questa decisione può presentare ricorso al TAR entro 60 giorni.&#10;&#10;Ufficio Cultura del Comune di Valfiorita" />
        <activiti:field name="allegati" stringValue="Nessuno" />
      </extensionElements>
    </serviceTask>
    <endEvent id="fineNonAmmissibile" name="Domanda non ammissibile" />
    <exclusiveGateway id="esitoGw" name="Contributo concesso?" default="fNegato" />
    <serviceTask id="emailConcesso" name="Comunica la concessione" implementation="emailConnector">
      <extensionElements>
        <activiti:field name="destinatari" stringValue="campo:pec" />
        <activiti:field name="oggetto" stringValue="Domanda di contributo ${numeroProtocollo}: contributo concesso" />
        <activiti:field name="testo" stringValue="Gentile associazione,&#10;&#10;per l'evento &quot;${titoloEvento}&quot; le è stato concesso un contributo di ${importoConcesso} euro.&#10;${motivazioneDecisione}&#10;&#10;La Ragioneria provvederà al pagamento.&#10;&#10;Ufficio Cultura del Comune di Valfiorita" />
        <activiti:field name="allegati" stringValue="Tutti i documenti della pratica" />
      </extensionElements>
    </serviceTask>
    <userTask id="liquidazione" name="Liquida il contributo" activiti:candidateGroups="ragioneria" activiti:formKey="ce-liquidazione" />
    <endEvent id="fineLiquidato" name="Contributo liquidato" />
    <serviceTask id="emailNegato" name="Comunica il diniego" implementation="emailConnector">
      <extensionElements>
        <activiti:field name="destinatari" stringValue="campo:pec" />
        <activiti:field name="oggetto" stringValue="Domanda di contributo ${numeroProtocollo}: contributo non concesso" />
        <activiti:field name="testo" stringValue="Gentile associazione,&#10;&#10;per l'evento &quot;${titoloEvento}&quot; il contributo non è stato concesso:&#10;${motivazioneDecisione}&#10;&#10;Contro questa decisione può presentare ricorso al TAR entro 60 giorni.&#10;&#10;Ufficio Cultura del Comune di Valfiorita" />
        <activiti:field name="allegati" stringValue="Nessuno" />
      </extensionElements>
    </serviceTask>
    <endEvent id="fineNegato" name="Contributo negato" />
    <sequenceFlow id="f1" sourceRef="inizio" targetRef="protocolla" />
    <sequenceFlow id="f2" sourceRef="protocolla" targetRef="conferma" />
    <sequenceFlow id="f3" sourceRef="erroreProtocollo" targetRef="protocolloManuale" />
    <sequenceFlow id="f4" sourceRef="protocolloManuale" targetRef="conferma" />
    <sequenceFlow id="f5" sourceRef="conferma" targetRef="istruttoria" />
    <sequenceFlow id="f6" sourceRef="istruttoria" targetRef="dopoIstruttoria" />
    <sequenceFlow id="fIntegrazioni" name="Servono integrazioni" sourceRef="dopoIstruttoria" targetRef="integrazioni">
      <conditionExpression xsi:type="tFormalExpression">${esitoVerifica == 'Serve integrazione'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fNonAmmissibile" name="Non ammissibile" sourceRef="dopoIstruttoria" targetRef="emailNonAmmissibile">
      <conditionExpression xsi:type="tFormalExpression">${esitoVerifica == 'Non ammissibile'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fDecisa" name="Decisa" sourceRef="dopoIstruttoria" targetRef="esitoGw" />
    <sequenceFlow id="fRiesame" name="Riprende l'istruttoria" sourceRef="integrazioni" targetRef="istruttoria" />
    <sequenceFlow id="f7" sourceRef="nessunaIntegrazione" targetRef="fineArchiviata" />
    <sequenceFlow id="f8" sourceRef="emailNonAmmissibile" targetRef="fineNonAmmissibile" />
    <sequenceFlow id="fConcesso" name="Concesso" sourceRef="esitoGw" targetRef="emailConcesso">
      <conditionExpression xsi:type="tFormalExpression">${esito == 'Concesso'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fNegato" name="Negato" sourceRef="esitoGw" targetRef="emailNegato" />
    <sequenceFlow id="f9" sourceRef="emailConcesso" targetRef="liquidazione" />
    <sequenceFlow id="f10" sourceRef="liquidazione" targetRef="fineLiquidato" />
    <sequenceFlow id="f11" sourceRef="emailNegato" targetRef="fineNegato" />
    <sequenceFlow id="f12" sourceRef="termine60" targetRef="avvisoTermine" />
    <sequenceFlow id="f13" sourceRef="avvisoTermine" targetRef="fineTermine" />
    <sequenceFlow id="f14" sourceRef="rinuncia" targetRef="fineRinuncia" />
  </process>
