<?xml version="1.0" encoding="UTF-8"?>
<!--
  Esempio "Verifica pratica": nessuna riga di codice dedicata, solo configurazione.
  - solo i dirigenti possono avviarla (candidateStarterGroups)
  - allegati all'avvio, in lettura per gli analisti, modificabili (nuove versioni) dai revisori: lo decide il form
  - ciclo analista <-> revisore finché la pratica non viene accettata
  - notifica al dirigente con il connettore generico "notificaConnector"
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:activiti="http://activiti.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://example.com/verifica">

  <process id="verificaPratica" name="Verifica pratica" isExecutable="true"
           activiti:candidateStarterGroups="dirigenti">
    <documentation>Pratiche con documenti firmati: verifica degli analisti, eventuale revisione, notifica al dirigente.</documentation>

    <startEvent id="start" name="Nuova pratica" activiti:formKey="vp-nuova"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="verifica"/>

    <userTask id="verifica" name="Verifica pratica"
              activiti:candidateGroups="analisti" activiti:formKey="vp-verifica"/>
    <sequenceFlow id="f2" sourceRef="verifica" targetRef="esitoVerifica"/>

    <exclusiveGateway id="esitoVerifica" name="Esito?" default="fRevisione"/>
    <sequenceFlow id="fAccettata" name="Accettata" sourceRef="esitoVerifica" targetRef="notifica">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${esito == 'Accettata'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fRevisione" name="Da revisionare" sourceRef="esitoVerifica" targetRef="revisione"/>

    <userTask id="revisione" name="Revisione pratica"
              activiti:candidateGroups="revisori" activiti:formKey="vp-revisione"/>
    <sequenceFlow id="f3" sourceRef="revisione" targetRef="verifica"/>

    <serviceTask id="notifica" name="Notifica al dirigente" implementation="notificaConnector">
      <extensionElements>
        <activiti:field name="destinatario" stringValue="iniziatore"/>
        <activiti:field name="titolo" stringValue="Pratica accettata: ${oggetto}"/>
        <activiti:field name="messaggio" stringValue="La pratica &quot;${oggetto}&quot; è stata verificata e accettata da ${chiusaDa}."/>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="f4" sourceRef="notifica" targetRef="end"/>

    <endEvent id="end" name="Pratica accettata"/>
  </process>

  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="verificaPratica">
      <bpmndi:BPMNShape id="s_start" bpmnElement="start"><dc:Bounds x="80" y="142" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_verifica" bpmnElement="verifica"><dc:Bounds x="170" y="120" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_gw" bpmnElement="esitoVerifica" isMarkerVisible="true"><dc:Bounds x="345" y="135" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_notifica" bpmnElement="notifica"><dc:Bounds x="460" y="120" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_end" bpmnElement="end"><dc:Bounds x="640" y="142" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_revisione" bpmnElement="revisione"><dc:Bounds x="310" y="270" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="e_f1" bpmnElement="f1"><di:waypoint x="116" y="160"/><di:waypoint x="170" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f2" bpmnElement="f2"><di:waypoint x="290" y="160"/><di:waypoint x="345" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_ok" bpmnElement="fAccettata"><di:waypoint x="395" y="160"/><di:waypoint x="460" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_rev" bpmnElement="fRevisione"><di:waypoint x="370" y="185"/><di:waypoint x="370" y="270"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_back" bpmnElement="f3"><di:waypoint x="310" y="310"/><di:waypoint x="230" y="310"/><di:waypoint x="230" y="200"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f4" bpmnElement="f4"><di:waypoint x="580" y="160"/><di:waypoint x="640" y="160"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
