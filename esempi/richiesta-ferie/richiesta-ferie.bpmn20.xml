<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:activiti="http://activiti.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://example.com/ferie">

  <process id="richiestaFerie" name="Richiesta ferie" isExecutable="true">

    <startEvent id="start" name="Nuova richiesta" activiti:formKey="ferie-nuova"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="approva"/>

    <!-- Il responsabile decide -->
    <userTask id="approva" name="Approva richiesta"
              activiti:candidateGroups="responsabili"
              activiti:formKey="ferie-approva"/>
    <sequenceFlow id="f2" sourceRef="approva" targetRef="decisione"/>

    <!-- In base all'esito la pratica prende strade diverse -->
    <exclusiveGateway id="decisione" name="Approvata?" default="fRespinta"/>
    <sequenceFlow id="fApprovata" name="Sì" sourceRef="decisione" targetRef="registra">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${esito == 'Approvata'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fRespinta" name="No" sourceRef="decisione" targetRef="endRespinta"/>

    <!-- Solo se approvata: un operatore registra le ferie -->
    <userTask id="registra" name="Registra ferie"
              activiti:candidateGroups="operatori"
              activiti:formKey="ferie-registra"/>
    <sequenceFlow id="f3" sourceRef="registra" targetRef="endApprovata"/>

    <endEvent id="endApprovata" name="Ferie approvate"/>
    <endEvent id="endRespinta" name="Richiesta respinta"/>
  </process>

  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="richiestaFerie">
      <bpmndi:BPMNShape id="s_start" bpmnElement="start"><dc:Bounds x="80" y="142" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_approva" bpmnElement="approva"><dc:Bounds x="170" y="120" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_decisione" bpmnElement="decisione" isMarkerVisible="true"><dc:Bounds x="345" y="135" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_registra" bpmnElement="registra"><dc:Bounds x="460" y="120" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_endOk" bpmnElement="endApprovata"><dc:Bounds x="640" y="142" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_endKo" bpmnElement="endRespinta"><dc:Bounds x="352" y="262" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="e_f1" bpmnElement="f1"><di:waypoint x="116" y="160"/><di:waypoint x="170" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f2" bpmnElement="f2"><di:waypoint x="290" y="160"/><di:waypoint x="345" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_ok" bpmnElement="fApprovata"><di:waypoint x="395" y="160"/><di:waypoint x="460" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_ko" bpmnElement="fRespinta"><di:waypoint x="370" y="185"/><di:waypoint x="370" y="262"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f3" bpmnElement="f3"><di:waypoint x="580" y="160"/><di:waypoint x="640" y="160"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
