<?xml version="1.0" encoding="UTF-8"?>
<!--
  Segnalazioni di SpotBugs/FindSecBugs verificate e non applicabili, con il motivo.
  Ogni voce nuova va motivata qui: il file si allega ai rapporti di analisi per le gare.
-->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

  <!--
    Token CSRF di Spring disattivato di proposito:
    - /api/v1: solo chiave API nell'intestazione X-API-Key, nessun cookie né sessione;
    - resto dell'applicazione: le richieste che modificano dati da un browser devono avere X-Requested-With
      (SecurityConfig.FiltroRichiesteSessione, provato da FiltroRichiesteSessioneTest).
  -->
  <Match>
    <Class name="com.eligesoft.orditogram.SecurityConfig"/>
    <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED"/>
  </Match>

  <!--
    Iniezione di righe nei log (CWE-117): neutralizzata per tutti i log dal formato in application.yml
    (logging.pattern: %replace(%m){'[\r\n]+', ' '}), che toglie gli a capo da ogni messaggio.
  -->
  <Match>
    <Bug pattern="CRLF_INJECTION_LOGS"/>
  </Match>

  <!-- Solo un elenco degli endpoint Spring, non un problema: l'inventario delle API è nell'OpenAPI. -->
  <Match>
    <Bug pattern="SPRING_ENDPOINT"/>
  </Match>
</FindBugsFilter>
