# Copia in .env e modifica. Usato da docker-compose.yml.

# Profilo: "produzione" da un cliente (Orditogram non parte con password predefinite, utenti di prova o senza
# chiave di cifratura: vedi README, "Installazione in produzione"). Vuoto per demo e prove in locale.
ORDITOGRAM_PROFILO=produzione

ORDITOGRAM_VERSIONE=latest
ORDITOGRAM_PORTA=8081                 # Orditogram sarà su http://localhost:8081
# Indirizzo con cui gli utenti aprono Orditogram (nome host e porta), es. orditogram.ente.it
ORDITOGRAM_INDIRIZZO=localhost:8081

# Database
DB_NOME=orditogram
DB_UTENTE=orditogram
DB_PASSWORD=cambiami                  # almeno 12 caratteri in produzione
DB_PORTA=5432

# Primo avvio: password dell'amministratore (utente "admin")
ADMIN_PASSWORD_INIZIALE=cambiami-subito  # almeno 12 caratteri in produzione

# Dati e servizi di prova: true solo per demo e test
UTENTI_DI_PROVA=false
SERVIZI_DI_PROVA=false
PROCESSI_DI_PROVA=false   # processi di esempio "Hello World BPMN" e "Pratica"

# Email (vuoto = notifiche solo nell'applicazione)
SMTP_HOST=
SMTP_PORTA=587
SMTP_UTENTE=
SMTP_PASSWORD=
EMAIL_MITTENTE=noreply@example.com

# Chiave per cifrare i segreti salvati nel database (webhook). Genera una frase lunga e casuale,
# ad esempio con: openssl rand -base64 32   — e non cambiarla più.
ORDITOGRAM_CHIAVE_CIFRATURA=

# Siti che chiamano l'API pubblica direttamente dal browser (separati da virgola)
API_CORS_ORIGINI=

# Chiavi per le integrazioni (vedi README: credenziali e messaggi)
PROTOCOLLO_API_KEY=
PORTALE_API_KEY=

JAVA_OPTS=-XX:MaxRAMPercentage=75
