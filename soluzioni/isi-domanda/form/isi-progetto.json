      "name": "asse",
      "label": "Asse di finanziamento",
      "type": "select",
      "options": [
        "1.1 Rischi tecnopatici",
        "1.2 Modelli organizzativi",
        "2 Rischi infortunistici",
        "3 Bonifica amianto",
        "4 Settori specifici (micro e piccole)",
        "5.1 Agricoltura",
        "5.2 Giovani agricoltori"
      ],
      "visibileAlleParti": true,
      "help": "Se cambi asse, i dati del progetto che non valgono per il nuovo asse non contano più nel calcolo."
