{
 "openapi": "3.1.0",
 "info": {
  "title": "Orditogram – API pubblica",
  "version": "1 (Orditogram 0.10.0)",
  "description": "API per i sistemi esterni (portali, gestionali, app): avviare pratiche, seguirne lo stato, scambiare documenti e messaggi. I percorsi di avvio e i messaggi sono generati dai processi pubblicati: i dati richiesti sono quelli dei form disegnati nello Studio.\n\n**Autenticazione**: una chiave creata in Studio → Integrazioni, nell'intestazione `X-API-Key` oppure come `Authorization: Bearer <chiave>`. Ogni chiave ha i suoi permessi e può essere limitata ad alcuni processi.\n\n**Errori**: sempre nel formato `{\"errore\": {\"codice\", \"messaggio\", \"campi\"}}`; il codice è stabile.\n\n**Avvisi (webhook)**: Orditogram può chiamare un tuo indirizzo quando succede qualcosa (vedi la sezione webhooks). Ogni avviso è firmato con HMAC-SHA256 nell'intestazione `X-Orditogram-Firma`."
 },
 "servers": [
  {
   "url": "http://localhost:8080/api/v1",
   "description": "Questa installazione"
  }
 ],
 "security": [
  {
   "chiaveApi": []
  },
  {
   "bearer": []
  }
 ],
 "tags": [
  {
   "name": "Processi",
   "description": "Le tipologie di pratica che si possono avviare"
  },
  {
   "name": "Pratiche",
   "description": "Avvio, ricerca, stato e storico"
  },
  {
   "name": "Documenti",
   "description": "Documenti delle pratiche"
  },
  {
   "name": "Messaggi",
   "description": "Messaggi attesi dalle pratiche (es. integrazioni, pagamenti, rinunce)"
  },
  {
   "name": "Sistema",
   "description": "Verifica della chiave e documentazione"
  }
 ],
 "paths": {
  "/processi": {
   "get": {
    "tags": [
     "Processi"
    ],
    "operationId": "elencoProcessi",
    "summary": "Processi che la chiave può usare",
    "description": "Ultima versione di ogni processo pubblicato, con i dati da inviare all'avvio e i messaggi che riceve.",
    "responses": {
     "200": {
      "description": "Elenco dei processi",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/Processo"
         }
        }
       }
      }
     },
     "401": {
      "description": "Chiave mancante o non valida",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Errore"
        }
       }
      }
     },
     "429": {
      "description": "Troppe richieste: riprova dopo i secondi indicati in Retry-After"
     }
    }
   }
  },
  "/processi/{chiave}": {
   "get": {
    "tags": [
     "Processi"
    ],
    "operationId": "processo",
    "summary": "Un processo",
    "parameters": [
     {
      "name": "chiave",
      "in": "path",
      "required": true,
      "description": "Chiave del processo (es. accessoAtti)",
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Il processo",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Processo"
        }
       }
      }
     },
     "404": {
      "description": "Processo non trovato",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Errore"
        }
       }
      }
     },
     "401": {
      "description": "Chiave mancante o non valida",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Errore"
        }
       }
      }
     },
     "429": {
      "description": "Troppe richieste: riprova dopo i secondi indicati in Retry-After"
     }
    }
   }
  },
  "/processi/accessoAtti/pratiche": {
   "post": {
    "tags": [
     "Pratiche"
    ],
    "operationId": "avvia_accessoAtti",
    "summary": "Avvia: Accesso agli atti",
    "description": "Legge 241/1990\n\nVersione 3. Allegati all'avvio: obbligatori.\n\nDati: `oggetto` (obbligatorio), `emailRichiedente` (obbligatorio), `tipoAccesso` (obbligatorio), `importo`, `privacy` (obbligatorio)",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Avvio_accessoAtti"
       },
       "example": {
        "riferimento": "DOM-2026-0042",
        "dati": {
         "oggetto": "Oggetto",
         "emailRichiedente": "mario.rossi@example.com",
         "tipoAccesso": "Visione",
         "importo": 100,
         "privacy": true
        }
       }
      },
      "multipart/form-data": {
       "schema": {
        "type": "object",
        "properties": {
         "richiesta": {
          "type": "string",
          "contentMediaType": "application/json",
          "description": "Il JSON di avvio (stesso formato del corpo JSON)"
         },
         "documenti": {
          "type": "array",
          "items": {
           "type": "string",
           "contentMediaType": "application/octet-stream"
          },
          "description": "Almeno un documento"
         }
        },
        "required": [
         "richiesta",
         "documenti"
        ]
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "Pratica avviata",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PraticaCreata"
        }
       }
      }
     },
     "200": {
      "description": "Esisteva già una pratica con lo stesso riferimento: è quella",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PraticaCreata"
        }
       }
      }
     },
     "422": {
      "description": "Dati non validi (dettagli in errore.campi)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Errore"
        }
       }
      }
     },
     "403": {
      "description": "La chiave non può avviare questo processo",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Errore"
        }
       }
      }
     },
     "401": {
      "description": "Chiave mancante o non valida",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Errore"
        }
       }
      }
     },
     "429": {
      "description": "Troppe richieste: riprova dopo i secondi indicati in Retry-After"
     }
    }
   }
  },
  "/pratiche": {
   "get": {
    "tags": [
     "Pratiche"
    ],
    "operationId": "cercaPratiche",
    "summary": "Cerca pratiche",
    "description": "Pratiche dei processi consentiti alla chiave, le più recenti prima.",
    "parameters": [
     {
      "name": "processo",
      "in": "query",
      "required": false,
      "description": "Chiave del processo",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "stato",
      "in": "query",
      "required": false,
      "description": "Stato",
      "schema": {
       "type": "string",
       "enum": [
        "in_corso",
        "conclusa"
       ]
      }
     },
     {
      "name": "riferimento",
      "in": "query",
      "required": false,
      "description": "Il tuo riferimento, indicato all'avvio",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "dal",
      "in": "query",
      "required": false,
      "description": "Avviate da questa data (inclusa)",
      "schema": {
       "type": "string",
       "format": "date"
      }
     },
     {
      "name": "al",
      "in": "query",
      "required": false,
      "description": "Avviate fino a questa data (inclusa)",
      "schema": {
       "type": "string",
       "format": "date"
      }
     },
     {
      "name": "pagina",
      "in": "query",
      "required": false,
      "description": "Numero di pagina, da 0",
      "schema": {
       "type": "integer",
       "minimum": 0,
       "default": 0
      }
     },
     {
      "name": "dimensione",
      "in": "query",
      "required": false,
      "description": "Pratiche per pagina",
      "schema": {
       "type": "integer",
       "minimum": 1,
       "maximum": 200,
       "default": 50
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Una pagina di pratiche",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PaginaPratiche"
        }
       }
      }
     },
     "401": {
      "description": "Chiave mancante o non valida",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Errore"
        }
       }
      }
     },
     "429": {
      "description": "Troppe richieste: riprova dopo i secondi indicati in Retry-After"
     }
    }
   },
   "post": {
    "tags": [
     "Pratiche"
    ],
    "operationId": "avviaPratica",
    "summary": "Avvia una pratica (qualunque processo)",
    "description": "Come i percorsi /processi/{chiave}/pratiche, con il processo indicato nel corpo. Per allegare documenti usa il percorso del processo.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "oneOf": [
         {
          "$ref": "#/components/schemas/AvvioGenerico_accessoAtti"
         }
        ],
        "discriminator": {
         "propertyName": "processo",
         "mapping": {
          "accessoAtti": "#/components/schemas/AvvioGenerico_accessoAtti"
         }
        }
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "Pratica avviata",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PraticaCreata"
        }
       }
      }
     },
     "200": {
      "description": "Esisteva già una pratica con lo stesso riferimento: è quella",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PraticaCreata"
        }
       }
      }
     },
     "422": {
      "description": "Dati non validi (dettagli in errore.campi)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Errore"
        }
       }
      }
     },
     "403": {
      "description": "La chiave non può avviare questo processo",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Errore"
        }
       }
      }
     },
     "401": {
      "description": "Chiave mancante o non valida",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Errore"
        }
       }
      }
     },
     "429": {
      "description": "Troppe richieste: riprova dopo i secondi indicati in Retry-After"
     }
    }
   }
  },
