  "/messaggi/rinunciaRichiedente": {
   "post": {
    "tags": [
     "Messaggi"
    ],
    "operationId": "messaggio_rinunciaRichiedente",
    "summary": "Messaggio: rinunciaRichiedente",
    "description": "Atteso da: Accesso agli atti. Indica la pratica con `pratica` (id) oppure con `cerca` (dati della pratica, es. il numero di protocollo). Dati ammessi: motivoRinuncia.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "pratica": {
          "type": "string",
          "description": "Id della pratica"
         },
         "cerca": {
          "type": "object",
          "description": "Dati con cui trovare la pratica, es. {\"numeroProtocollo\": \"2026/000123\"}",
          "additionalProperties": {
           "type": [
            "string",
            "number",
            "boolean"
           ]
          }
         },
         "dati": {
          "$ref": "#/components/schemas/DatiMessaggio_rinunciaRichiedente"
         }
        }
       },
       "example": {
        "cerca": {
         "riferimento": "DOM-2026-0042"
        },
        "dati": {
         "motivoRinuncia": "…"
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Messaggio consegnato",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "consegnato": {
           "type": "boolean"
          },
          "pratiche": {
           "type": "array",
           "items": {
            "type": "string"
           }
          }
         }
        }
       }
      }
     },
     "404": {
      "description": "Nessuna pratica sta aspettando il messaggio",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Errore"
        }
       }
      }
     },
     "409": {
      "description": "Il criterio corrisponde a più pratiche",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Errore"
        }
       }
      }
     },
     "401": {
      "description": "Chiave mancante o non valida",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Errore"
        }
       }
      }
     },
     "429": {
      "description": "Troppe richieste: riprova dopo i secondi indicati in Retry-After"
     }
    }
   }
  },
