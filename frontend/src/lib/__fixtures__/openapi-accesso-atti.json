 "components": {
  "securitySchemes": {
   "chiaveApi": {
    "type": "apiKey",
    "in": "header",
    "name": "X-API-Key"
   },
   "bearer": {
    "type": "http",
    "scheme": "bearer",
    "description": "La stessa chiave, come token Bearer"
   }
  },
  "schemas": {
   "Errore": {
    "type": "object",
    "properties": {
     "errore": {
      "type": "object",
      "properties": {
       "codice": {
        "type": "string",
        "examples": [
         "dati_non_validi",
         "non_trovato",
         "permesso_mancante",
         "chiave_non_valida",
         "troppe_richieste",
         "conflitto"
        ]
       },
       "messaggio": {
        "type": "string"
       },
       "campi": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "campo": {
           "type": "string"
          },
          "messaggio": {
           "type": "string"
          }
         }
        }
       }
      },
      "required": [
       "codice",
       "messaggio"
      ]
     }
    },
    "required": [
     "errore"
    ]
   },
   "Campo": {
    "type": "object",
    "properties": {
     "nome": {
      "type": "string"
     },
     "etichetta": {
      "type": "string"
     },
     "tipo": {
      "type": "string",
      "enum": [
       "text",
       "textarea",
       "number",
       "date",
       "select",
       "checkbox"
      ]
     },
     "obbligatorio": {
      "type": "boolean"
     },
     "opzioni": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "aiuto": {
      "type": "string"
     }
    }
   },
   "Processo": {
    "type": "object",
    "properties": {
     "chiave": {
      "type": "string"
     },
     "nome": {
      "type": "string"
     },
     "descrizione": {
      "type": "string"
     },
     "versione": {
      "type": "integer"
     },
     "campi": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Campo"
      }
     },
     "allegati": {
      "type": "string",
      "enum": [
       "nessuno",
       "facoltativi",
       "obbligatori"
      ]
     },
     "messaggi": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "nome": {
         "type": "string"
        },
        "dati": {
         "type": "array",
         "items": {
          "type": "string"
         }
        }
       }
      }
     },
     "avvio": {
      "type": "string",
      "description": "Percorso per avviare una pratica di questo processo"
     }
    },
    "required": [
     "chiave",
     "nome",
     "versione",
     "campi",
     "allegati"
    ]
   },
   "Attivita": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "nome": {
      "type": "string"
     },
     "chiave": {
      "type": "string",
      "description": "Id dell'attività nel BPMN"
     },
     "assegnatario": {
      "type": "string"
     },
     "gruppi": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "dal": {
      "type": "string",
      "format": "date-time"
     }
    }
   },
   "Scadenza": {
    "type": "object",
    "properties": {
     "tipo": {
      "type": "string",
      "enum": [
       "scadenza",
       "sollecito",
       "attesa"
      ]
     },
     "nome": {
      "type": "string"
     },
     "attivita": {
      "type": "string"
     },
     "quando": {
      "type": "string",
      "format": "date-time"
     }
    }
   },
   "Pratica": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "titolo": {
      "type": "string"
     },
     "riferimento": {
      "type": "string",
      "description": "Il riferimento indicato all'avvio"
     },
     "processo": {
      "type": "object",
      "properties": {
       "chiave": {
        "type": "string"
       },
       "nome": {
        "type": "string"
       },
       "versione": {
        "type": "integer"
       }
      }
     },
     "stato": {
      "type": "string",
      "enum": [
       "in_corso",
       "conclusa"
      ]
     },
     "avviata": {
      "type": "string",
      "format": "date-time"
     },
     "conclusa": {
      "type": "string",
      "format": "date-time"
     },
     "avviataDa": {
      "type": "string"
     },
     "attivitaCorrenti": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Attivita"
      }
     },
     "scadenze": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Scadenza"
      }
     },
     "messaggiAttesi": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "nome": {
         "type": "string"
        },
        "elemento": {
         "type": "string"
        }
       }
      }
     },
     "dati": {
      "type": "object",
