    <startEvent id="inizio" activiti:formKey="e2e-doc-avvio"/>
    <sequenceFlow id="f1" sourceRef="inizio" targetRef="dati"/>
    <userTask id="dati" name="Completa i dati e allega i documenti" activiti:candidateGroups="operatori" activiti:formKey="e2e-doc-dati"/>
