<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:activiti="http://activiti.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://example.com/pratica">

  <process id="pratica" name="Pratica" isExecutable="true">

    <!-- Il form di avvio raccoglie oggetto, descrizione, priorità -->
    <startEvent id="start" name="Nuova pratica" activiti:formKey="nuova-pratica"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="gestisciPratica"/>

    <!-- Un operatore la prende in carico e clicca "Termina pratica" -->
    <userTask id="gestisciPratica" name="Gestisci pratica"
              activiti:candidateGroups="operatori"
              activiti:formKey="gestisci-pratica"/>
    <sequenceFlow id="f2" sourceRef="gestisciPratica" targetRef="end"/>

    <endEvent id="end" name="Pratica chiusa"/>
  </process>

  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="pratica">
      <bpmndi:BPMNShape id="s_start" bpmnElement="start"><dc:Bounds x="100" y="120" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_gestisci" bpmnElement="gestisciPratica"><dc:Bounds x="200" y="98" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_end" bpmnElement="end"><dc:Bounds x="400" y="120" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="e_f1" bpmnElement="f1"><di:waypoint x="136" y="138"/><di:waypoint x="200" y="138"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f2" bpmnElement="f2"><di:waypoint x="340" y="138"/><di:waypoint x="400" y="138"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
