<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.eligesoft</groupId>
  <artifactId>orditogram</artifactId>
  <version>0.11.0</version>

  <properties>
    <java.version>21</java.version>
    <!--
      Activiti 8.8.x è costruita su Spring Boot 3.5.x: tieni le due versioni allineate.
      Activiti 8.8.1 (luglio 2026) è l'ultima versione stabile per Java 21; la 9.0.0 cambia solo Java (25) e resta
      su Spring Boot 3.5. Spring Boot 4 arriverà con Activiti 9.1, oggi ancora in alpha.
    -->
    <activiti.version>8.8.1</activiti.version>
    <!-- correzioni di sicurezza più recenti di quelle comprese in Spring Boot (vedi analisi del codice) -->
    <tomcat.version>10.1.62</tomcat.version>
    <postgresql.version>42.7.14</postgresql.version>
    <!-- ultime versioni compatibili con Spring Boot 3.5 (correzioni di sicurezza) -->
    <jackson-bom.version>2.21.8</jackson-bom.version>
    <commons-lang3.version>3.22.0</commons-lang3.version>
    <log4j2.version>2.26.1</log4j2.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        Activiti fissa le versioni di Spring, Jackson e Micrometer di quando è uscita: queste importazioni, che
        vengono prima, riportano le librerie alle versioni corrette di Spring Boot (vince la prima importata).
      -->
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-framework-bom</artifactId>
        <version>${spring-framework.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.security</groupId>
        <artifactId>spring-security-bom</artifactId>
        <version>${spring-security.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.data</groupId>
        <artifactId>spring-data-bom</artifactId>
        <version>${spring-data-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-bom</artifactId>
        <version>${micrometer.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.activiti</groupId>
        <artifactId>activiti-dependencies</artifactId>
        <version>${activiti.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.activiti</groupId>
      <artifactId>activiti-spring-boot-starter</artifactId>
      <exclusions>
        <!--
          Activiti porta la vecchia implementazione della posta (com.sun.mail 2.0.1, vulnerabile a SMTP injection):
          la sostituisce quella aggiornata di Spring Boot (Eclipse Angus), stessa API jakarta.mail.
        -->
        <exclusion>
          <groupId>com.sun.mail</groupId>
          <artifactId>jakarta.mail</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- Stato di salute per Docker / Kubernetes: /actuator/health -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Accesso con Keycloak / Microsoft Entra ID (OIDC): si attiva solo se configurato in application.yml -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
    </dependency>
    <!-- Tabelle applicative (utenti) via JPA; Activiti continua a usare le sue tabelle ACT_* -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Notifiche via email (attive solo se configuri spring.mail.host) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <!-- Verifica firme PAdES (PDF) e CAdES (.p7m) -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.8</version>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <version>1.87</version>
    </dependency>

    <!-- Test: motore e applicazione veri, database in memoria (H2) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Gli artefatti Activiti 8 sono pubblicati sul repository Alfresco -->
  <repositories>
    <repository>
      <id>activiti-releases</id>
      <url>https://artifacts.alfresco.com/nexus/content/repositories/activiti-releases/</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <!-- versione e data di build visibili in /actuator/info e nell'applicazione -->
          <execution>
            <goals><goal>build-info</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Analisi del codice (workflow "Analisi del codice" in CI): mvn -Panalisi verify
      copertura dei test (JaCoCo), SpotBugs con FindSecBugs, distinta delle librerie (SBOM CycloneDX, configurata da Spring Boot).
    -->
    <profile>
      <id>analisi</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>0.8.13</version>
            <executions>
              <execution>
                <id>agente</id>
                <goals><goal>prepare-agent</goal></goals>
              </execution>
              <execution>
                <id>rapporto</id>
                <phase>verify</phase>
                <goals><goal>report</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-maven-plugin</artifactId>
            <version>4.9.8.1</version>
            <configuration>
              <effort>Max</effort>
              <threshold>Low</threshold>
              <xmlOutput>true</xmlOutput>
              <failOnError>false</failOnError>
              <!-- falsi positivi verificati, ognuno con il motivo -->
              <excludeFilterFile>${project.basedir}/../strumenti/analisi/spotbugs-esclusioni.xml</excludeFilterFile>
              <plugins>
                <plugin>
                  <groupId>com.h3xstream.findsecbugs</groupId>
                  <artifactId>findsecbugs-plugin</artifactId>
                  <version>1.14.0</version>
                </plugin>
              </plugins>
            </configuration>
            <executions>
              <execution>
                <phase>verify</phase>
                <goals><goal>spotbugs</goal></goals>
              </execution>
            </executions>
          </plugin>
          <!-- distinta delle librerie: la configura Spring Boot (target/classes/META-INF/sbom/application.cdx.json) -->
          <plugin>
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-maven-plugin</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
